{
  "name": "matreshka-parse-form",
  "version": "2.4.17",
  "description": "Binds the named fields of an HTML form to object properties, for Matreshka.js",
  "keywords": [
    "matreshka",
    "form",
    "data-binding"
  ],
  "homepage": "https://matreshka.js.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finom/matreshka.git",
    "directory": "packages/parse-form"
  },
  "author": "Andrey Gubanov <andrey.a.gubanov@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/finom/matreshka/issues"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "unpkg": "./dist/matreshka-parse-form.min.js",
  "jsdelivr": "./dist/matreshka-parse-form.min.js",
  "exports": {
    ".": {
      "module-sync": "./dist/esm/index.sync.js",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*",
    "./*.js": {
      "module-sync": "./dist/esm/*.js",
      "import": "./dist/esm/*.js",
      "require": "./dist/cjs/*.js"
    },
    "./*": {
      "module-sync": "./dist/esm/*.js",
      "import": "./dist/esm/*.js",
      "require": "./dist/cjs/*.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs parse-form",
    "prepublishOnly": "node ../../scripts/ci-only.mjs"
  },
  "peerDependencies": {
    "matreshka": "^2.4.18"
  }
}
