{
  "name": "matreshka-router",
  "version": "2.4.18",
  "description": "Two-way binding between object properties and parts of the URL, for Matreshka.js",
  "keywords": [
    "matreshka",
    "router",
    "routing",
    "history",
    "hash"
  ],
  "homepage": "https://matreshka.js.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finom/matreshka.git",
    "directory": "packages/router"
  },
  "author": "Andrey Gubanov <andrey.a.gubanov@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/finom/matreshka/issues"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "unpkg": "./dist/matreshka-router.min.js",
  "jsdelivr": "./dist/matreshka-router.min.js",
  "exports": {
    ".": {
      "module-sync": "./dist/esm/index.sync.js",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./router": {
      "module-sync": "./dist/esm/router.sync.js",
      "import": "./dist/esm/router.js",
      "require": "./dist/cjs/router.js"
    },
    "./router.js": {
      "module-sync": "./dist/esm/router.sync.js",
      "import": "./dist/esm/router.js",
      "require": "./dist/cjs/router.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*",
    "./*.js": {
      "module-sync": "./dist/esm/*.js",
      "import": "./dist/esm/*.js",
      "require": "./dist/cjs/*.js"
    },
    "./*": {
      "module-sync": "./dist/esm/*.js",
      "import": "./dist/esm/*.js",
      "require": "./dist/cjs/*.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs router",
    "prepublishOnly": "node ../../scripts/ci-only.mjs"
  },
  "peerDependencies": {
    "matreshka": "^2.4.18"
  }
}
