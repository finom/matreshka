{
  "name": "matreshka-repo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/matreshka",
    "packages/router",
    "packages/parse-form",
    "docs"
  ],
  "scripts": {
    "lint": "biome check --error-on-warnings .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "set -e; for P in matreshka router parse-form; do npm run build --prefix ./packages/$P; done",
    "patch": "node scripts/release.mjs patch",
    "minor": "node scripts/release.mjs minor",
    "check:dist": "node scripts/check-dist.mjs && node --no-experimental-require-module scripts/check-dist.mjs",
    "exports": "node scripts/exports.mjs --write",
    "build:docs": "npm run build -w matreshka-docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finom/matreshka.git"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/plugin-transform-modules-commonjs": "^8.0.1",
    "@biomejs/biome": "^2.5.15",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@vitest/coverage-v8": "^5.0.4",
    "jsdom": "^30.1.2",
    "rollup": "^4.64.6",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "nextra": {
      "zod": "4.3.6"
    },
    "nextra-theme-docs": {
      "zod": "4.3.6"
    },
    "@xmldom/xmldom": "^0.9.12",
    "katex": "^0.18.11"
  }
}
