{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "packages/*/src/**/*.js",
      "packages/*/test/**/*.js",
      "scripts/*.mjs",
      "*.mjs",
      "docs/**/*.{js,jsx,ts,tsx,mjs}",
      "!docs/.next",
      "!docs/out",
      "!docs/public",
      "!**/next-env.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "none"
    }
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noArguments": "off"
      }
    }
  }
}
