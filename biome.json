{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "src/**/*.{js,ts}",
      "test/**/*.{js,ts}",
      "scripts/*.mjs",
      "*.mjs",
      "*.ts",
      "docs/**/*.{js,jsx,ts,tsx,mjs}",
      "!docs/out",
      "!docs/public"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "none"
    }
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noArguments": "off"
      },
      "suspicious": {
        "noExplicitAny": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["test/legacy/**"],
      "linter": {
        "rules": {
          "complexity": {
            "useArrowFunction": "off"
          },
          "style": {
            "useTemplate": "off"
          }
        }
      }
    }
  ]
}
